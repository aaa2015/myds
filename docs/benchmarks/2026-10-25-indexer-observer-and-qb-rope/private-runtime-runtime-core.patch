+enum { IK_REQUESTS,IK_ENCODED,IK_FALLBACKS,IK_FAILURES,IK_F32,IK_BF16,IK_COUNT };
+static _Atomic uint64_t indexer_k_counters[IK_COUNT];
+static pthread_once_t indexer_k_once=PTHREAD_ONCE_INIT;
+static int indexer_k_mode;
+static void indexer_k_init(void) {
+    const char *value=getenv("MYDS_INDEXER_K_RESIDENT");
+    if(!value||!strcmp(value,"0"))indexer_k_mode=0;
+    else if(!strcmp(value,"1"))indexer_k_mode=1;
+    else {
+        indexer_k_mode=-1;
+        MYDS_LOG_E("MYDS_INDEXER_K_RESIDENT must be exactly absent, 0 or 1");
+    }
+}
+int myds_v41_gpu_indexer_k_resident_enabled(void) {
+    pthread_once(&indexer_k_once,indexer_k_init);
+    return indexer_k_mode;
+}
+const char *myds_v41_gpu_indexer_k_resident_selected_kernel(bool bf16) {
+    if(myds_v41_gpu_indexer_k_resident_enabled()!=1)return NULL;
+    return bf16?"kernel_myds_indexer_scores_k_resident_bf16":
+                "kernel_myds_indexer_scores_k_resident_f32";
+}
+void myds_v41_gpu_indexer_k_resident_counters(
+    myds_v41_gpu_indexer_k_resident_counters_t *out,bool reset) {
+    uint64_t v[IK_COUNT];
+    for(unsigned i=0;i<IK_COUNT;i++)v[i]=reset?
+        atomic_exchange_explicit(&indexer_k_counters[i],0u,memory_order_relaxed):
+        atomic_load_explicit(&indexer_k_counters[i],memory_order_relaxed);
+    if(out)*out=(myds_v41_gpu_indexer_k_resident_counters_t){v[0],v[1],v[2],v[3],v[4],v[5]};
+}
+static int indexer_k_failure(const char *reason) {
+    atomic_fetch_add_explicit(&indexer_k_counters[IK_FAILURES],1u,memory_order_relaxed);
+    MYDS_LOG_E("K-resident prefill indexer failed: %s; refusing native fallback",reason);
+    return 0;
+}
