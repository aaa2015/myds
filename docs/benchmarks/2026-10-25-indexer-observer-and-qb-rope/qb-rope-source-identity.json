  "proof": {
    "exact_edits": [
      {
        "after": "static inline void myds_qb_rope_probe_body(",
        "before": "static inline void myds_q4_v41_body("
      },
      {
        "after": "        constant myds_q4_v41_args &args,\n        constant ds4_metal_args_dsv41_rope &rope,\n",
        "before": "        constant myds_q4_v41_args &args,\n"
      },
      {
        "after": "    static_assert(ROWS==32768u && WIDTH==1280u && FIXED_NB && BF16 && NR==2u,\n                  \"probe accepts only original full Q_B NR2/NB/BF16 shape\");\n    device float *dst_f32=(device float *)dst;\n    // Both collectives remain uniform over all 32 lanes, in row 0/1 order.\n    float sum0=simd_sum(sumf[0]);\n    float sum1=simd_sum(sumf[1]);\n    if(tiisg==0) {\n        // Original Q_B store boundary, before any rotation arithmetic.\n        const float re=myds_q4_v41_bf16(sum0);\n        const float im=myds_q4_v41_bf16(sum1);\n        const uint head_dim=first_row%512u;\n        if(head_dim>=448u) {\n            const uint pair=(head_dim-448u)/2u;\n            // Same F32 multiply, precise trig, affine order and BF16 helper\n            // as kernel_dsv41_rope for rows=1, stride=1, inverse=0.\n            const float theta = float(rope.start) * rope.frequencies[pair];\n            const float c = precise::cos(theta);\n            const float s = precise::sin(theta);\n            dst_f32[first_row] = dsv41_bf16(re * c - im * s);\n            dst_f32[first_row+1u] = dsv41_bf16(re * s + im * c);\n        } else {\n            dst_f32[first_row]=re;\n            dst_f32[first_row+1u]=im;\n        }\n    }",
        "before": "    device float *dst_f32=(device float *)dst;\n    for(int row=0;row<(int)NR;++row) {\n        float sum_all=simd_sum(sumf[row]);\n        if(tiisg==0) dst_f32[first_row+row]=BF16 ? myds_q4_v41_bf16(sum_all) : sum_all;\n    }"
      }
    ],
    "k_loop_and_original_bf16_helper_unchanged": true,
