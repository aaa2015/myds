diff --git a/tests/test_deepseek41_metal.c b/tests/test_deepseek41_metal.c
index 533b1eb..cd5ecdc 100644
--- a/tests/test_deepseek41_metal.c
+++ b/tests/test_deepseek41_metal.c
@@ -1360,8 +1360,102 @@ static int check_index_score_wide(void) {
