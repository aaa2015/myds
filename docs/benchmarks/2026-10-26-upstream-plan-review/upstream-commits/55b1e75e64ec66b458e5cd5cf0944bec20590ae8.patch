+static bool ds41_index_q_project(ds41_gpu_graph *g, const ds4_model *m,
+                                 const ds4_layer_weights *l, uint32_t il) {
+#ifdef __APPLE__
+    ds4_gpu_tensor *codes = NULL, *scales = NULL;
+    if (!g->quality && ds41_indexer_e4m3(m, l, il, &codes, &scales) &&
