+# Explicit CPU build/link only. No production target or shader build is invoked.
+# Example: make -f tools/decode_kv_only_fullmodel.mk BUILD_DIR=/tmp/idx/build \
+#   BIN_DIR=/tmp/idx/bin /tmp/idx/bin/bench_decode_kv_only_fullmodel
+include Makefile
+.DEFAULT_GOAL := $(BIN_DIR)/bench_decode_kv_only_fullmodel
+
+DECODE_KV_BASE_INCLUDE := $(abspath $(BUILD_DIR)/bench_decode_kv_only_fullmodel_base.inc)
+DECODE_KV_ADAPTER_FLAG :=
+ifneq ($(DECODE_KV_ADAPTER_HEADER),)
+DECODE_KV_ADAPTER_FLAG := -DMYDS_BENCH_DECODE_KV_ADAPTER_HEADER='"$(abspath $(DECODE_KV_ADAPTER_HEADER))"'
+endif
+
+# Adapter selection changes compile-time behavior. Recompile this small wrapper
+# on every explicit build so reusing an object cannot silently drop its API.
+.PHONY: decode-kv-fullmodel-driver-force
+decode-kv-fullmodel-driver-force:
+
+$(DECODE_KV_BASE_INCLUDE): tools/bench_output_a_fullmodel.c tools/prepare_decode_kv_only_fullmodel.py tools/decode_kv_only_fullmodel_state.inc | $(BUILD_DIR)
+	python3 tools/prepare_decode_kv_only_fullmodel.py --base tools/bench_output_a_fullmodel.c --out "$@"
+
+$(BUILD_DIR)/bench_decode_kv_only_fullmodel.o: tools/bench_decode_kv_only_fullmodel.c $(DECODE_KV_BASE_INCLUDE) $(wildcard include/*.h) $(DECODE_KV_ADAPTER_HEADER) decode-kv-fullmodel-driver-force | $(BUILD_DIR)
+	$(CC) $(CFLAGS) -I"$(abspath tools)" -DMYDS_BENCH_DECODE_KV_BASE_INCLUDE='"$(DECODE_KV_BASE_INCLUDE)"' $(DECODE_KV_ADAPTER_FLAG) -c $< -o $@
+
+$(BIN_DIR)/bench_decode_kv_only_fullmodel: $(filter-out $(BUILD_DIR)/main.o,$(OBJS_C)) $(OBJS_M) $(BUILD_DIR)/bench_decode_kv_only_fullmodel.o | $(BIN_DIR)
+	$(CC) $(filter %.o,$^) $(LDFLAGS) -o $@
