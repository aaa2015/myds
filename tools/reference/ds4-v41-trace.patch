+/* Integer selection IDs are serialized as exact F32 values so the shared
+ * stage comparator reports IDs numerically, not as float bit reinterpretations. */
+static void metal_graph_debug_dump_ids(const char *name, ds4_gpu_tensor *t,
+                                      uint32_t count, uint32_t il, uint32_t pos) {
+    const char *prefix = metal_graph_debug_prefix_for(name, il, pos);
+    if (!prefix || !t || !count) return;
+    if (!ds4_gpu_synchronize()) return;
+    int32_t *ids = xmalloc((size_t)count * sizeof(*ids));
+    float *values = xmalloc((size_t)count * sizeof(*values));
+    if (ds4_gpu_tensor_read(t, 0, ids, (uint64_t)count * sizeof(*ids))) {
+        for (uint32_t i = 0; i < count; i++) values[i] = (float)ids[i];
+        char path[1024];
+        snprintf(path, sizeof(path), "%s_%s-%u_pos%u.bin", prefix, name, il, pos);
+        if (!write_f32_binary_file(path, values, count))
+            fprintf(stderr, "ds4: cannot write ID trace %s\n", path);
+    }
+    free(ids); free(values);
+    if (!ds4_gpu_begin_commands())
+        fprintf(stderr, "ds4: cannot resume after ID trace\n");
 }
 
