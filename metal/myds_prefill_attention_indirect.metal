template [[host_name("kernel_myds_prefill_attention_indirect_f16_dk512_dv512")]]
kernel myds_prefill_attention_indirect_t probe_myds_flash_attn_ext_vec_indirect<half4, half4, half4, float, float, float4, float4, half4, 1, dequantize_f16_t4, half4, 1, dequantize_f16_t4, 512, 512, 1, 1, 32, true>;
